{
  "name": "vaya",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @vaya/api dev",
    "dev:mobile": "pnpm --filter @vaya/mobile start",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@vaya/api",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=\"./packages/*\" --filter=\"./apps/api\"",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @vaya/api db:migrate",
    "db:generate": "pnpm --filter @vaya/api db:generate",
    "db:studio": "pnpm --filter @vaya/api db:studio",
    "db:seed": "pnpm --filter @vaya/api db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "generate:api-client": "pnpm --filter @vaya/api-client generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.12.3"
}
