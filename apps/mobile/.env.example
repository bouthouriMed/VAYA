# Mobile app environment configuration
# These values are used at build time via expo-constants

API_BASE_URL=http://localhost:3000/api/v1

# react-native-maps needs a Google Maps API key on Android (iOS uses Apple
# Maps, no key needed). Get one from https://console.cloud.google.com/
# (enable "Maps SDK for Android"). Without it, the map renders as a blank
# gray area on Android but the app still works otherwise.
GOOGLE_MAPS_API_KEY=
