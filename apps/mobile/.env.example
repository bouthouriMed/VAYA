# Mobile app environment configuration
# These values are used at build time via expo-constants

API_BASE_URL=http://localhost:3000/api/v1

# react-native-maps (Google Maps SDK) needs a per-platform key, each with
# DIFFERENT restrictions in Google Cloud Console — never the same key as
# GOOGLE_MAPS_SERVER_API_KEY in apps/api/.env.example, which must never ship
# inside the mobile bundle. Both keys below are compiled into the native app
# binary (app.config.js) and are effectively public — their safety comes
# entirely from platform-application restriction, not secrecy:
#   Android — "Android apps" restriction: package name com.vaya.app +
#     your release/debug SHA-1 certificate fingerprint. API restriction:
#     "Maps SDK for Android" only.
#   iOS — "iOS apps" restriction: bundle id com.vaya.app. API restriction:
#     "Maps SDK for iOS" only.
# Get both from https://console.cloud.google.com/ (enable the two Maps SDKs
# above). Without a key, the corresponding platform's map renders as a blank
# gray area but the app still works otherwise (unchanged fallback behavior).
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Push notifications (Android/FCM). Not an env var — a file:
# apps/mobile/google-services.json, downloaded from Firebase console
# (project vaya-f3eaa > Project settings > Your apps > com.vaya.app app).
# Gitignored (see .gitignore), so a fresh clone needs it copied in
# manually; app.config.js references it via android.googleServicesFile.
# Without it, the app builds/runs fine — push token registration just
# silently fails on Android.
