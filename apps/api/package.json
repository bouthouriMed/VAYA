{
  "name": "@vaya/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint src/ scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "verify-migrations": "tsx scripts/verify-migrations.ts",
    "preflight": "tsx scripts/preflight.ts",
    "worker": "tsx watch src/worker.ts",
    "worker:start": "tsx src/worker.ts",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10",
    "@fastify/static": "^8.0.2",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/websocket": "^11.0.2",
    "@sentry/node": "^10.74.0",
    "@vaya/config": "workspace:*",
    "@vaya/domain": "workspace:*",
    "@vaya/validation": "workspace:*",
    "bullmq": "^6.1.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "google-auth-library": "^11.0.2",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "prom-client": "^15.1.3",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.24.2",
    "eslint": "^9.11.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
