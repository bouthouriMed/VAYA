NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://vaya:vaya_dev@localhost:5433/vaya
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
CORS_ORIGIN=*
API_PREFIX=/api/v1
OSRM_URL=http://localhost:5001

# Google OAuth (Sign in with Google) — get from https://console.cloud.google.com/
# ("Web application" client type: needs a client secret + an exact redirect
# URI). Google rejects raw private IPs (192.168.x.x, 10.x.x.x) as redirect
# URIs — only the literal hostname "localhost" or a real public HTTPS domain
# are accepted. For a physical device (where "localhost" resolves to the
# phone, not your dev machine), point GOOGLE_CALLBACK_URL at a public tunnel
# instead, e.g. `npx cloudflared tunnel --url http://localhost:4000` (free,
# no signup) and use the https://*.trycloudflare.com URL it prints — then
# register that exact URL in GCP's Authorized redirect URIs. GOOGLE_OAUTH_
# CALLBACK_PORT is the LOCAL port server.ts binds the callback listener to
# (independent of whatever port, if any, appears in GOOGLE_CALLBACK_URL
# itself — a tunnel domain has none, it's implicitly 443). Leave all vars
# empty to leave Google sign-in disabled (the app falls back to phone/OTP).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
GOOGLE_OAUTH_CALLBACK_PORT=4000

# --- Google Maps Platform (location/routing) -------------------------------
# Server-side key for Places API (New), Routes API, and the Geocoding API.
# ONE key, not three: all three are called only from this trusted backend
# process (never from the mobile client), so there is no security or
# operational benefit to separate keys — Google Cloud API-key restriction is
# per-API, not per-key-count, so a single key can be scoped in Google Cloud
# Console to exactly {Places API (New), Routes API, Geocoding API} and
# nothing else, with a server-IP restriction. Use GOOGLE_PLACES_API_KEY /
# GOOGLE_ROUTES_API_KEY / GOOGLE_GEOCODING_API_KEY below ONLY if you
# deliberately want separate quota/billing isolation per API (e.g. a
# per-service spend alert) — LocationService/RoutingService (lib/google/)
# both fall back to GOOGLE_MAPS_SERVER_API_KEY when their specific override
# is unset, so setting only the one shared key is the normal path.
# Leave blank to keep the existing OSRM/Nominatim providers active (both
# still work, unchanged, as the no-Google-key fallback — see
# lib/location-provider.ts / lib/routing-provider.ts).
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# Which provider LocationService/RoutingService use. 'auto' (default) picks
# google when GOOGLE_MAPS_SERVER_API_KEY is set, otherwise falls back to the
# existing osrm+nominatim path unchanged — set explicitly only to force one
# path regardless of key presence (e.g. 'osrm' in a Google-quota-free CI run).
LOCATION_PROVIDER=auto
ROUTING_PROVIDER=auto

# Location search/autocomplete is scoped to Tunisia by default (true), since
# that's VAYA's actual market. Set to 'false' to search anywhere in the
# world instead — Tortosa, Barcelona, Paris, Switzerland, Algeria, Dakar,
# etc. — useful for demoing or testing outside Tunisia. Applies to whichever
# provider is active (google or nominatim).
LOCATION_RESTRICT_TO_TUNISIA=true

# PostGIS-backed spatial candidate filtering in matching.service.ts. Requires
# the postgis/postgis Docker image (see docker/docker-compose.yml) and
# migration 0014 (CREATE EXTENSION postgis) to have actually run — set to
# false to keep the pre-PostGIS application-level haversine/polyline path
# (still fully present, unchanged) if your Postgres has no PostGIS extension.
POSTGIS_ENABLED=true
